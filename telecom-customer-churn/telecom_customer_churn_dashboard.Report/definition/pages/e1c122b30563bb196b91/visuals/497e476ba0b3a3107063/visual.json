              {
                "textRuns": [
                  {
                    "value": "Protect High-Value Fiber Customers:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#eec017"
                    }
                  },
                  {
                    "value": " Fiber Optic users have the highest monthly bills ($91.50 avg) but also the highest churn rate (41.9%). Offer tech support bundles or small loyalty discounts to keep these high-paying customers from leaving.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#ffffff"
                    }
                  }
                ]
              },
              {
                "textRuns": [

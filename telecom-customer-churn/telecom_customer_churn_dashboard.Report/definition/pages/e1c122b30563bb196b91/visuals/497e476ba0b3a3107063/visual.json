                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Support & Security Bundles:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#eec017"
                    }
                  },
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  },
                  {
                    "value": "Customers without Tech Support or Online Security churn at over 40%, compared to those with. Include basic security features in initial sign-up packages to keep new users anchored.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#ffffff"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Incentivize Long-Term Contracts:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#eec017"
                    }
                  },
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#eec017"
                    }
                  },
                  {
                    "value": "Month-to-month users represent the bulk of churn risk. Package streaming add-ons into 1 and 2 year contract promotions to lock in engagement.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#ffffff"
                    }
                  }
                ]
              },
              {
                "textRuns": [

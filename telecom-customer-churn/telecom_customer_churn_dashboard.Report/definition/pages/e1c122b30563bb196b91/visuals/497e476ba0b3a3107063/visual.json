                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Phone Service Neutrality: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#eec017"
                    }
                  },
                  {
                    "value": "Despite personal mobile phones, phone service shows negligible impact on churn (26.7% vs 24.9%) Marketing and retention budget should be spent on internet packages and add-ons instead.",
